{
	"name": "pi-context-compress",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Independent Pi session range compression and context tools.",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"exports": {
		".": "./src/index.ts",
		"./protocol": "./src/protocol.ts"
	},
	"pi": {
		"extensions": ["./src/index.ts"]
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/__tests__/**",
		"LICENSE",
		"LICENSE.workstream",
		"README.md",
		"PROTOCOL.md",
		"ORIGIN.md"
	],
	"scripts": {
		"test": "vitest run",
		"check": "npm run typecheck && npm run lint",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"chalk": "5.6.2",
		"minimatch": "10.2.6",
		"typebox": "1.3.7",
		"yargs-parser": "22.0.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "0.84.3",
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@earendil-works/pi-tui": "0.84.3"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@earendil-works/pi-ai": "0.84.3",
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@earendil-works/pi-tui": "0.84.3",
		"@types/node": "22.20.1",
		"@types/yargs-parser": "21.0.3",
		"@xterm/headless": "5.5.0",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	}
}
