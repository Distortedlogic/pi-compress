{
	"name": "pi-compress",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Distortedlogic/pi-compress.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"exports": {
		".": "./src/index.ts",
		"./protocol": "./src/protocol.ts",
		"./range-compression": "./src/range-compression.ts"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"README.md",
		"PROTOCOL.md"
	],
	"scripts": {
		"test": "node --import tsx --test test/*.test.ts",
		"check": "npm run typecheck && npm run lint && npm test && npm run knip",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"knip": "knip"
	},
	"dependencies": {
		"minimatch": "10.2.6"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-ai": "1.1.0",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@earendil-works/pi-tui": "1.1.0",
		"@types/node": "22.20.4",
		"knip": "6.35.1",
		"tsx": "4.23.15",
		"typebox": "1.3.34",
		"typescript": "7.0.2"
	},
	"knip": {
		"entry": [
			"src/index.ts",
			"src/protocol.ts",
			"src/range-compression.ts",
			"test/**/*.test.ts"
		],
		"project": [
			"src/**/*.ts"
		]
	}
}
